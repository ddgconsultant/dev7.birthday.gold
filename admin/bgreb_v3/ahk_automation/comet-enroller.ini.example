[API]
BaseUrl=https://dev7.birthday.gold
ApiKey=YOUR_API_KEY_HERE

[Comet]
ExePath=C:\Users\USERNAME\AppData\Local\Comet\Application\comet.exe
WindowTitle=Comet

[Automation]
PromptText=Read this page. Enroll this user in all PENDING programs using the profile data and field mappings shown. Open each signup URL, fill the form, and report the result for each program.

[Logging]
LogFile=comet-enroller.log
