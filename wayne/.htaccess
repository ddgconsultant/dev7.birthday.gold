# Allow access to this directory
Options +Indexes
DirectoryIndex index.html

# Allow all access
Require all granted
Allow from all

# Set the default file
<IfModule dir_module>
    DirectoryIndex index.html index.htm
</IfModule>

# Allow HTML, CSS, JS files
<FilesMatch "\.(html|htm|css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$">
    Require all granted
</FilesMatch>