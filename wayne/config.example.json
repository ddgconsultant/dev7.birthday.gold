{
    "app": {
        "name": "Wayne Project",
        "version": "1.0.0",
        "environment": "development",
        "debug": true,
        "url": "http://localhost/wayne",
        "timezone": "America/New_York"
    },
    "database": {
        "host": "localhost",
        "port": 3306,
        "name": "wayne_db",
        "user": "wayne_user",
        "password": "your_password_here",
        "charset": "utf8mb4",
        "prefix": "wp_"
    },
    "api": {
        "enabled": true,
        "version": "v1",
        "rate_limit": {
            "enabled": true,
            "requests_per_minute": 60,
            "requests_per_hour": 1000
        },
        "cors": {
            "enabled": true,
            "allowed_origins": ["*"],
            "allowed_methods": ["GET", "POST", "PUT", "DELETE"],
            "allowed_headers": ["Content-Type", "Authorization"]
        },
        "authentication": {
            "type": "bearer",
            "secret_key": "your-secret-key-here",
            "token_expiry": 3600
        }
    },
    "mail": {
        "driver": "smtp",
        "host": "smtp.gmail.com",
        "port": 587,
        "username": "your-email@gmail.com",
        "password": "your-app-password",
        "encryption": "tls",
        "from": {
            "address": "noreply@wayne-project.com",
            "name": "Wayne Project"
        }
    },
    "cache": {
        "enabled": true,
        "driver": "file",
        "path": "/tmp/wayne_cache",
        "ttl": 3600
    },
    "logging": {
        "enabled": true,
        "level": "debug",
        "path": "logs/app.log",
        "max_files": 30,
        "channels": ["file", "database"]
    },
    "security": {
        "csrf_protection": true,
        "xss_protection": true,
        "sql_injection_protection": true,
        "session": {
            "lifetime": 120,
            "encrypt": true,
            "http_only": true,
            "same_site": "lax"
        }
    },
    "features": {
        "registration": true,
        "email_verification": true,
        "two_factor_auth": false,
        "social_login": false,
        "api_access": true,
        "file_uploads": true,
        "notifications": true
    },
    "storage": {
        "default": "local",
        "disks": {
            "local": {
                "driver": "local",
                "root": "storage/app",
                "permissions": {
                    "file": "0644",
                    "dir": "0755"
                }
            },
            "public": {
                "driver": "local",
                "root": "storage/app/public",
                "url": "/storage",
                "visibility": "public"
            },
            "s3": {
                "driver": "s3",
                "key": "your-aws-key",
                "secret": "your-aws-secret",
                "region": "us-east-1",
                "bucket": "wayne-bucket",
                "url": null,
                "endpoint": null
            }
        }
    },
    "services": {
        "stripe": {
            "enabled": false,
            "public_key": "pk_test_...",
            "secret_key": "sk_test_...",
            "webhook_secret": "whsec_..."
        },
        "google": {
            "maps_api_key": "your-google-maps-key",
            "analytics_id": "UA-XXXXXXXXX-X",
            "recaptcha": {
                "site_key": "your-site-key",
                "secret_key": "your-secret-key"
            }
        },
        "social": {
            "facebook": {
                "app_id": "your-facebook-app-id",
                "app_secret": "your-facebook-secret"
            },
            "twitter": {
                "consumer_key": "your-twitter-key",
                "consumer_secret": "your-twitter-secret"
            }
        }
    },
    "performance": {
        "minify_html": false,
        "minify_css": false,
        "minify_js": false,
        "gzip_compression": true,
        "browser_cache": true,
        "cdn": {
            "enabled": false,
            "url": "https://cdn.wayne-project.com"
        }
    }
}